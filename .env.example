# HealthSolver legacy/local development only.
# The current Research Edition is browser-only on GitHub Pages and does not
# require these settings.

# Core local paths
DATABASE_URL=sqlite:///./healthsolver.db
HEALTHSOLVER_LOG_DIR=logs
HEALTHSOLVER_PATIENT_DATA_PATH=datasets/patient_data.csv
HEALTHSOLVER_LEGACY_THERAPY_MODEL_PATH=models/saved_models/therapy_model.pkl
HEALTHSOLVER_CNN_MODEL_PATH=models/saved_models/cnn_dicom_model.pth

# Legacy browser/API boundary
HEALTHSOLVER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional legacy feature gates (disabled unless explicitly enabled)
ENABLE_LEGACY_ANALYTICS=0
ENABLE_LEGACY_CNN=0
ENABLE_LEGACY_ADMIN_ROUTES=0
ENABLE_LEGACY_AUTH=0
ENABLE_LEGACY_EHR=0
ENABLE_LEGACY_PACS=0

# EHR/PACS are fail-closed: no external FHIR endpoint is contacted unless set.
HEALTHSOLVER_FHIR_BASE_URL=
HEALTHSOLVER_PACS_URL=http://localhost:8042/dicom-web
HEALTHSOLVER_PACS_TIMEOUT_SECONDS=10

# Optional Redis cache; HealthSolver bypasses the cache when Redis is unavailable.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=2

# Deprecated training/MLflow
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_DB=mlflow_data/mlflow.db

# Deprecated encryption helper. Supply a valid Fernet key only if that helper is used.
APP_SECRET_KEY=
ANONYMIZATION_SALT=

# Optional legacy PostgreSQL helper: password has intentionally no default.
POSTGRES_DB=healthsolver
POSTGRES_USER=healthsolver
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO
