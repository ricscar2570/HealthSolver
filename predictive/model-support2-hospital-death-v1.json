  "target_definition": {
    "fixed_horizon": false,
    "interpretation": "Source in-hospital death label among seriously ill hospitalized SUPPORT patients; not 30-day/90-day mortality and not a general-population mortality probability.",
    "negative": "0 = survived hospitalization",
    "positive": "1 = death in hospital",
    "source_name": "hospdead",
    "survival_probability": false
  },
  "task": "Binary research classification of SUPPORT2 hospdead using a predeclared day-3/baseline feature set after split-first protocol.",
  "temporal_semantics": "Most physiologic assessments are study-day-3 values. The model is therefore a day-3/baseline hospital-outcome classifier, not an admission-time model. Hospital death has no single fixed follow-up duration in this released table.",
  "threshold": 0.24330849889113282,
  "threshold_selection": "Youden J maximum on held-out calibration split; evaluated once on untouched held-out test",
  "version": "1.0.1",
  "input_timepoint_policy": "Age and sex may be reused from the common dossier. Day-3 physiology is never silently substituted from generic dossier fields because those fields do not encode the SUPPORT day-3 timepoint. A day-3 value counts as observed only when explicitly entered in the SUPPORT2 panel; if absent, it is treated as missing under the model abstention/imputation policy."
