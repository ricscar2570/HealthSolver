  "target_definition": {
    "binary_mapping": "HealthSolver positive = LET_IS != 0",
    "clinical_diagnosis": false,
    "interpretation": "Classification of the source lethal-outcome label among hospitalized acute-MI records; not a general-population mortality probability.",
    "negative": "0 = unknown (alive) in the UCI source coding",
    "positive": "1-7 = lethal outcome cause recorded (cardiogenic shock, pulmonary edema, myocardial rupture, CHF progression, thromboembolism, asystole, or ventricular fibrillation)",
    "source_name": "LET_IS"
  },
  "task": "Binary research classification of the UCI LET_IS lethal-outcome label from a predeclared 21-feature admission-time subset; positive class means LET_IS is one of causes 1-7 rather than source value 0.",
  "temporal_semantics": "Prediction uses only UCI columns permitted at hospital admission. Dynamic source columns from the first three hospital days are excluded. Secondary analyses of this database describe fatal acute complications during the first 72 hours; HealthSolver labels the output as the source acute/hospital lethal-outcome class rather than claiming a universally validated fixed-horizon mortality score.",
  "threshold": 0.09213198859855104,
  "threshold_selection": "Youden J maximum on held-out calibration split; evaluated once on independent held-out test split",
  "version": "1.0.0",
  "feature_selection_limitation": "Because exploratory profiling computed univariate associations with LET_IS on the full dataset before the 21-feature shortlist was frozen, the final held-out test is independent of model fitting/calibration/threshold selection but not fully independent of feature-screening knowledge. Internal performance may therefore be optimistic and must be treated as exploratory until validated on an external cohort."
